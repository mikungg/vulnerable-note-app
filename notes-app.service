[Unit]
Description=Docker Application Container Engine
Documentation=https://docs.docker.com
After=network-online.target containerd.service docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/appsec-app
ExecStartPre=/bin/sh -c 'systemd-cat -t containerd -p info /bin/echo "Started libcontainer init process"'
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dockerd

[Install]
WantedBy=multi-user.target
